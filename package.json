{
  "name": "explorer",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev:ui": "yarn workspace @sig-net/explorer-ui dev",
    "dev:backend": "yarn workspace @sig-net/explorer-backend dev",
    "db:up": "docker compose -f packages/backend/compose.yaml up -d --wait",
    "db:down": "docker compose -f packages/backend/compose.yaml down",
    "build": "yarn workspaces foreach -A --exclude explorer --topological run build",
    "preview": "yarn workspace @sig-net/explorer-ui preview",
    "typecheck": "yarn workspaces foreach -A --exclude explorer --topological run typecheck",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "yarn workspaces foreach -A --exclude explorer --topological run test",
    "check": "yarn typecheck && yarn lint && yarn format:check && yarn test"
  },
  "devDependencies": {
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "resolutions": {
    "@midnightntwrk/ledger-v9": "1.0.1",
    "@midnightntwrk/onchain-runtime-v4": "4.0.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "yarn@4.18.0"
}
